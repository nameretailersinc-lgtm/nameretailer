# Owner's existing MOngodb_URI key is supported too; preferred spelling below.
# Atlas or another MongoDB replica set (transactions protect revisions/bulk/reset).
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB=nameretailer_cms
# Optional process-only DNS resolvers if the host resolver refuses Atlas SRV queries.
MONGODB_DNS_SERVERS=
NEXTAUTH_URL=http://localhost:3000
# Generate: node -e "process.stdout.write(require('crypto').randomBytes(48).toString('base64url'))"
NEXTAUTH_SECRET=
SITE_URL=https://nameretailer.com
MEDIA_ROOT=./uploads
# smtp in production; local captures development-only mail under .local/mail.
MAIL_TRANSPORT=local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Name Retailer <info@nameretailer.com>
# Shared cron/revalidation secret; never expose in browser.
CRON_SECRET=
# Trusted reverse proxy only: do not enable when direct requests can forge forwarded headers.
TRUST_PROXY=false
# Initial account password supplied temporarily for admin:create, then remove.
ADMIN_BOOTSTRAP_PASSWORD=

# Search Console / Bing Webmaster ownership tokens (content attribute of the meta tag only)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# GA4 measurement ID (G-XXXXXXX). Off when empty; scripts load only after analytics acceptance.
NEXT_PUBLIC_GA4_ID=
